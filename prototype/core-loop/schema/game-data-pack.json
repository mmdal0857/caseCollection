{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-collection/game-data-pack@1",
  "title": "게임 데이터 팩 (game-data-pack)",
  "description": "티켓 07·16의 계약: 게임이 로드하는 팩은 카드 재작성(04)·문맥 태그 추출(14)·case 생성까지 변환 완료된 '게임 데이터 팩'이다. base 팩(레포에 커밋된 공식 아티팩트)과 mod 팩(외부 로드)이 동일 포맷을 쓴다. 이 스키마는 형태 불변식만 담는다 — 교차 필드 불변식(record 키 == 항목 id, facet.key == `<cardId>:<frame>`, pieces.length == slots.length + 1, 병합 후 참조 무결성)은 로더(src/lib/datapack.ts)와 파이프라인 검증기가 집행한다. enum 어휘는 datapack.ts의 TAGS·SUITS·KINDS·FRAMES와 동기화되어야 하며 smoke-datapack.ts G절이 이를 기계 검증한다.",
  "type": "object",
  "required": ["format", "formatVersion", "id"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "game-data-pack",
      "description": "포맷 표식 — 다른 JSON을 팩으로 오인하지 않기 위한 식별자."
    },
    "formatVersion": {
      "const": 1,
      "description": "팩 포맷 버전. 로더는 자기가 모르는 미래 버전을 거부한다(버전 스큐 처리)."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "description": "팩 네임스페이스 id. base 팩은 'base', mod 팩은 'mod.<이름>' 관례. 병합 리포트의 프로버넌스 키가 된다."
    },
    "name": { "type": "string", "description": "표시용 팩 이름." },
    "version": { "type": "string", "description": "팩 콘텐츠 버전(포맷 버전과 별개)." },
    "clues": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/clue" },
      "description": "단서 카드. record 키는 카드 id와 같아야 한다. mod 팩이 base와 같은 id를 쓰면 상쇄(override)."
    },
    "patterns": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/pattern" },
      "description": "사건 골격(패턴) 카드. record 키 == id."
    },
    "hintDefs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/hintDef" },
      "description": "힌트 정의. record 키 == id."
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" },
      "description": "사건 목록. mod 팩의 같은 id는 base의 case를 교체, 새 id는 뒤에 추가."
    },
    "run": {
      "$ref": "#/$defs/run",
      "description": "run 전역 설정. base 팩은 전부 채워야 하고(병합 후 무결성 검사가 집행), mod 팩은 바꿀 필드만 싣는다(필드 단위 상쇄)."
    }
  },
  "$defs": {
    "tag": {
      "enum": ["공개", "은밀", "강압", "신중", "논리"],
      "description": "문맥 태그(티켓 12) — 얼굴 단위로 붙어 배경 상태 트랙을 민다."
    },
    "suit": {
      "enum": ["physical", "behavioral", "documentary", "forensic"],
      "description": "단서 슈트."
    },
    "kind": {
      "enum": ["사람", "사물", "행위", "기록", "현상"],
      "description": "존재 범주 — 드라마투르기·슬롯 부조화 판정의 축."
    },
    "frame": {
      "enum": ["route", "means", "trace", "action", "motive", "record", "omission", "scene", "identity"],
      "description": "추리적 역할 — 얼굴과 슬롯이 공유하는 축."
    },
    "facetGate": {
      "type": "object",
      "required": ["stat", "why"],
      "additionalProperties": false,
      "properties": {
        "stat": { "enum": ["heat", "trust", "axis"] },
        "gte": { "type": "number" },
        "lt": { "type": "number" },
        "why": { "type": "string", "description": "왜 막혔는지 — 플레이어에게 그대로 보여준다." }
      }
    },
    "facet": {
      "type": "object",
      "required": ["key", "frame", "meaning", "tags", "note"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[^:]+:[^:]+$",
          "description": "`<cardId>:<frame>` — 카드 id·frame과 일치해야 한다(로더가 집행)."
        },
        "frame": { "$ref": "#/$defs/frame" },
        "meaning": { "type": "string", "description": "이 얼굴로 읽었을 때 카드가 무엇인가 — 짧은 명사구." },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
        "note": { "type": "string", "description": "잠금 보상으로 열리는 수사 노트 텍스트." },
        "gate": { "$ref": "#/$defs/facetGate" },
        "needsPrev": {
          "type": "array",
          "items": { "$ref": "#/$defs/frame" },
          "description": "앞 슬롯에 잠긴 얼굴의 frame이 이 목록에 있어야 열린다(앞→뒤 단방향)."
        },
        "line": { "type": "string", "description": "두루마리에 새겨질 서사 한 줄." }
      }
    },
    "clue": {
      "type": "object",
      "required": ["id", "name", "suit", "kind", "tags", "text", "facets"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "suit": { "$ref": "#/$defs/suit" },
        "kind": { "$ref": "#/$defs/kind" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "description": "카드 단위 태그 — v10부터 표시용, 실제 영향력은 얼굴 태그." },
        "text": { "type": "string", "description": "수사 노트 의미 텍스트 — 검증 전 비공개." },
        "facets": {
          "type": "array",
          "items": { "$ref": "#/$defs/facet" },
          "minItems": 1,
          "description": "카드의 얼굴 목록. facets[0]은 획득 시 함께 아는 명백한 얼굴. frame은 카드 안에서 중복 불가."
        }
      }
    },
    "pattern": {
      "type": "object",
      "required": ["id", "name", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "hintDef": {
      "type": "object",
      "required": ["id", "name", "desc", "heatCost"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "heatCost": { "type": "number" }
      }
    },
    "condAnswer": {
      "type": "object",
      "required": ["stat", "gte", "then", "else"],
      "additionalProperties": false,
      "properties": {
        "stat": { "enum": ["heat", "trust"] },
        "gte": { "type": "number" },
        "then": { "type": "string" },
        "else": { "type": "string" }
      },
      "description": "배경 상태 조건부 정답 — then/else 둘 다 병합 후 clues에 존재해야 한다."
    },
    "slotRole": {
      "type": "object",
      "required": ["frame"],
      "additionalProperties": false,
      "properties": {
        "frame": { "$ref": "#/$defs/frame" },
        "noun": { "type": "string" },
        "avoidTags": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
        "quality": { "type": "string" },
        "accepts": { "type": "array", "items": { "$ref": "#/$defs/kind" } }
      }
    },
    "slot": {
      "type": "object",
      "required": ["id", "label", "answer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "answer": {
          "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/condAnswer" }]
        },
        "hit": { "type": "string" },
        "role": { "$ref": "#/$defs/slotRole" }
      }
    },
    "axis": {
      "type": "object",
      "required": ["id", "label", "low", "high", "init", "drivenBy", "hint"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "low": { "type": "string" },
        "high": { "type": "string" },
        "init": { "type": "number" },
        "drivenBy": { "$ref": "#/$defs/tag" },
        "hint": { "type": "string" }
      },
      "description": "case별 가변축(12 §5) — 재사용 풀에서 고른다."
    },
    "case": {
      "type": "object",
      "required": ["id", "title", "intro", "pieces", "slots", "patterns", "guestClues", "packPool"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "intro": { "type": "string" },
        "teaser": { "type": "string" },
        "contextHint": { "type": "string" },
        "pieces": {
          "type": "array",
          "items": { "type": "string" },
          "description": "추리문 조각 — slots.length + 1개(로더가 집행)."
        },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" }, "minItems": 1 },
        "patterns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "guestClues": { "type": "array", "items": { "type": "string" } },
        "guestPattern": { "type": "string" },
        "guestFacets": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^:]+:[^:]+$" },
          "description": "게스트가 이 사건에서만 빌려주는 얼굴 key — 병합 후 해당 카드의 실제 얼굴이어야 한다."
        },
        "axis": { "$ref": "#/$defs/axis" },
        "packPool": { "type": "array", "items": { "type": "string" } },
        "misfits": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "description": "misfits[slotId][cardId] = 손수 반응 문장."
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interludeEvents": {
          "type": "array",
          "items": { "type": "object" },
          "description": "인터루드 이벤트 — 프로토 단계라 형태를 느슨히 둔다. TODO(16): 계약 확정 시 조인다."
        },
        "interludeAP": { "type": "number" },
        "interludeActions": { "type": "array", "items": { "type": "object" } },
        "starterClues": { "type": "array", "items": { "type": "string" } },
        "starterPatterns": { "type": "array", "items": { "type": "string" } },
        "starterHints": { "type": "array", "items": { "type": "string" } },
        "initial": {
          "type": "object",
          "required": ["heat", "trust"],
          "additionalProperties": false,
          "properties": {
            "heat": { "type": "number" },
            "trust": { "type": "number" }
          }
        },
        "tagDeltas": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tag" },
          "additionalProperties": {
            "type": "object",
            "required": ["heat", "trust"],
            "additionalProperties": false,
            "properties": {
              "heat": { "type": "number" },
              "trust": { "type": "number" }
            }
          }
        },
        "badHeat": { "type": "number" }
      }
    }
  }
}
