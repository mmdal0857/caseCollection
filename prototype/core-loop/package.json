{
  "name": "core-loop-proto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "schema:generate": "node scripts/generate-pack-validator.mjs",
    "schema:check": "node scripts/generate-pack-validator.mjs --check",
    "smoke:validator-esm": "node scripts/smoke-validator-esm.mjs",
    "pack:migrate": "esbuild scripts/migrate-pack-v1-to-v2.ts --bundle --format=esm --platform=node --outfile=migrate-pack-v1-to-v2.mjs && node migrate-pack-v1-to-v2.mjs",
    "smoke": "esbuild smoke.ts --bundle --format=esm --platform=node --outfile=smoke.mjs && node smoke.mjs",
    "smoke:datapack": "esbuild smoke-datapack.ts --bundle --format=esm --platform=node --outfile=smoke-datapack.mjs && node smoke-datapack.mjs",
    "smoke:pack-storage": "esbuild smoke-pack-storage.ts --bundle --format=esm --platform=node --outfile=smoke-pack-storage.mjs && node smoke-pack-storage.mjs",
    "pack:check-file": "esbuild check-pack-file.ts --bundle --format=esm --platform=node --outfile=check-pack-file.mjs && node check-pack-file.mjs",
    "smoke:run-flow": "esbuild smoke-run-flow.ts --bundle --format=esm --platform=node --outfile=smoke-run-flow.mjs && node smoke-run-flow.mjs",
    "smoke:run-session": "esbuild smoke-run-session.ts --bundle --format=esm --platform=node --outfile=smoke-run-session.mjs && node smoke-run-session.mjs",
    "smoke:collection": "esbuild smoke-collection.ts --bundle --format=esm --platform=node --outfile=smoke-collection.mjs && node smoke-collection.mjs",
    "smoke:narrative": "esbuild smoke-narrative-content.ts --bundle --format=esm --platform=node --outfile=smoke-narrative-content.mjs && node smoke-narrative-content.mjs",
    "smoke:audio": "esbuild smoke-audio.ts --bundle --format=esm --platform=node --outfile=smoke-audio.mjs && node smoke-audio.mjs",
    "audio:generate": "node scripts/generate-higgsfield-audio.mjs",
    "audio:qa": "node scripts/audio-qa.mjs --spec audio/audio-spec.json --candidates .audio-candidates --report audio/audio-qa-report.json",
    "audio:audition": "node scripts/prepare-audio-audition.mjs",
    "audio:promote": "node scripts/promote-audio.mjs --spec audio/audio-spec.json --report audio/audio-qa-report.json --picks audio/audio-picks.json --out public/audio",
    "audio:verify": "node scripts/verify-audio-manifest.mjs",
    "audio:verify-page": "node scripts/prepare-final-audio-verification.mjs",
    "smoke:case-generator-e2e": "esbuild smoke-case-generator-e2e.ts --bundle --format=esm --platform=node --outfile=smoke-case-generator-e2e.mjs && node smoke-case-generator-e2e.mjs",
    "fixture:pg204": "esbuild build-pg204-fixture.ts --bundle --format=esm --platform=node --outfile=build-pg204-fixture.mjs && node build-pg204-fixture.mjs --source F:/Project/out/raw_texts/204.txt --out fixtures/case-generator/pg204-invisible-man.source.json",
    "e2e:case-generator": "esbuild e2e-case-generator.ts --bundle --format=esm --platform=node --outfile=e2e-case-generator.mjs && node e2e-case-generator.mjs",
    "prototype:case-generator": "esbuild case-generator-prototype.ts --bundle --format=esm --platform=node --outfile=case-generator-prototype.mjs && node case-generator-prototype.mjs",
    "prototype:case-generator:demo": "esbuild case-generator-prototype.ts --bundle --format=esm --platform=node --outfile=case-generator-prototype.mjs && node case-generator-prototype.mjs --demo",
    "generator:demo": "npm run prototype:case-generator:demo",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "ajv": "^8.17.1",
    "@types/node": "^26.1.2",
    "svelte": "^5.16.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
